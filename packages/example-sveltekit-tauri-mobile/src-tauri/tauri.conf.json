{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "gau-sveltekit-mobile",
  "version": "0.1.0",
  "identifier": "gau.sveltekit-mobile.dev",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "gau-sveltekit-mobile",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "gau"
        ]
      },
      "mobile": [
        {
          "scheme": "https",
          "host": "tauri.localhost",
          "pathPrefix": "/auth/mobile/"
        },
        {
          "scheme": "gaumobile"
        }
      ]
    }
  }
}
