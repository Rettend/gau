{
  "name": "@rttnd/gau",
  "type": "module",
  "version": "1.4.4",
  "packageManager": "bun@1.3.5",
  "description": "gau is a delightful auth library",
  "license": "MIT",
  "homepage": "https://github.com/Rettend/gau#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rettend/gau.git",
    "directory": "packages/gau"
  },
  "bugs": {
    "url": "https://github.com/Rettend/gau/issues"
  },
  "keywords": [
    "auth",
    "authentication",
    "oauth",
    "solid-js",
    "svelte",
    "bun",
    "tauri"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./adapters/drizzle": {
      "types": "./dist/src/adapters/drizzle/index.d.ts",
      "import": "./dist/src/adapters/drizzle/index.js"
    },
    "./adapters/memory": {
      "types": "./dist/src/adapters/memory/index.d.ts",
      "import": "./dist/src/adapters/memory/index.js"
    },
    "./cli": {
      "types": "./dist/src/cli/index.d.ts",
      "import": "./dist/src/cli/index.js"
    },
    "./client/vanilla": {
      "types": "./dist/src/client/vanilla/index.d.ts",
      "import": "./dist/src/client/vanilla/index.js"
    },
    "./client/solid": {
      "solid": "./dist/src/client/solid/index.jsx",
      "types": "./dist/src/client/solid/index.d.ts"
    },
    "./client/solid2": {
      "solid": "./dist/src/client/solid2/index.jsx",
      "types": "./dist/src/client/solid2/index.d.ts"
    },
    "./client/svelte": {
      "types": "./dist/src/client/svelte/index.svelte.d.ts",
      "import": "./dist/src/client/svelte/index.svelte.js"
    },
    "./client/svelte/Protected.svelte": {
      "types": "./dist/src/client/svelte/Protected/index.svelte.d.ts",
      "svelte": "./dist/src/client/svelte/Protected/index.svelte",
      "default": "./dist/src/client/svelte/Protected/index.svelte"
    },
    "./client/svelte/AuthProvider.svelte": {
      "types": "./dist/src/client/svelte/AuthProvider/index.svelte.d.ts",
      "svelte": "./dist/src/client/svelte/AuthProvider/index.svelte",
      "default": "./dist/src/client/svelte/AuthProvider/index.svelte"
    },
    "./core": {
      "types": "./dist/src/core/index.d.ts",
      "import": "./dist/src/core/index.js"
    },
    "./jwt": {
      "types": "./dist/src/jwt/index.d.ts",
      "import": "./dist/src/jwt/index.js"
    },
    "./oauth": {
      "types": "./dist/src/oauth/index.d.ts",
      "import": "./dist/src/oauth/index.js"
    },
    "./runtimes/bun": {
      "types": "./dist/src/runtimes/bun/index.d.ts",
      "import": "./dist/src/runtimes/bun/index.js"
    },
    "./runtimes/tauri": {
      "types": "./dist/src/runtimes/tauri/index.d.ts",
      "import": "./dist/src/runtimes/tauri/index.js"
    },
    "./solidstart": {
      "types": "./dist/src/solidstart/index.d.ts",
      "import": "./dist/src/solidstart/index.js"
    },
    "./sveltekit": {
      "types": "./dist/src/sveltekit/index.d.ts",
      "import": "./dist/src/sveltekit/index.js"
    }
  },
  "bin": {
    "gau": "dist/src/cli/index.js"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run --watch index.ts",
    "build": "bun --bun tsup",
    "lint": "bun --bun eslint . --fix",
    "check": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p src/client/solid/tsconfig.json && tsgo --noEmit -p src/client/solid2/tsconfig.json && tsgo --noEmit -p src/client/svelte/tsconfig.json",
    "check:test": "tsgo --noEmit -p tsconfig.test.json",
    "update": "taze latest -wr",
    "test": "vitest --project fast",
    "test:pg": "vitest --project pg",
    "test:all": "vitest && bun run lint:test",
    "test:ui": "vitest --project fast --ui"
  },
  "peerDependencies": {
    "@solidjs/router": "^0.15.3 || ^0.16.0 || >=0.17.0-next.0 <1.0.0",
    "@solidjs/web": ">=2.0.0-beta.14 <3.0.0",
    "@sveltejs/kit": "^2.25.1",
    "@tauri-apps/api": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.3.0",
    "@tauri-apps/plugin-shell": "^2.3.0",
    "drizzle-orm": "^0.44.3",
    "solid-js": "^1.9.7 || >=2.0.0-beta.14 <3.0.0",
    "svelte": "^5.41.1",
    "typescript": "^5.8.3"
  },
  "peerDependenciesMeta": {
    "@solidjs/router": {
      "optional": true
    },
    "@solidjs/web": {
      "optional": true
    },
    "@sveltejs/kit": {
      "optional": true
    },
    "@tauri-apps/api": {
      "optional": true
    },
    "@tauri-apps/plugin-opener": {
      "optional": true
    },
    "@tauri-apps/plugin-shell": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@oslojs/jwt": "^0.3.0",
    "arctic": "^3.7.0",
    "cookie": "^1.1.1",
    "esm-env": "^1.2.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.1",
    "@electric-sql/pglite": "^0.3.14",
    "@libsql/client": "^0.15.15",
    "@solidjs/router": "^0.15.4",
    "@solidjs/web": "2.0.0-beta.14",
    "@sveltejs/kit": "^2.49.2",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.5",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "better-sqlite3": "^12.5.0",
    "bumpp": "^10.3.2",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "eslint": "^9.39.2",
    "solid-js": "^1.9.10",
    "solid-js-2": "npm:solid-js@2.0.0-beta.14",
    "svelte2tsx": "^0.7.51",
    "vitest": "^4.0.16"
  }
}
