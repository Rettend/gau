{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "types": ["vite-plus/test/globals", "node"],
    "noUncheckedIndexedAccess": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true
  },
  "include": ["test/**/*.ts"],
  "exclude": ["dist", "node_modules", "src/client"]
}
