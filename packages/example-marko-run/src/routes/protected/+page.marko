<div class="space-y-4">
  <h1 class="text-2xl tracking-tight">Protected page</h1>
  <p class="text-zinc-400">This session was read on the server for this page request.</p>
  <form method="post" action="/api/auth/signout?redirectTo=/">
    <button aria-label="Sign out" class="text-sm px-4 py-2 border border-red-900/30 rounded bg-red-900/20 hover:bg-red-900/40">/logout</button>
  </form>
  <pre class="text-sm p-4 border border-emerald-900/30 rounded bg-zinc-800 overflow-x-auto">${JSON.stringify($global.data.session, null, 2)}</pre>
</div>
