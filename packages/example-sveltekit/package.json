{
  "name": "gau-sveltekit-example",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev",
    "sync": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . --fix",
    "db:push": "bun --bun drizzle-kit push",
    "db:studio": "bun --bun drizzle-kit studio"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@rttnd/gau": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "@sveltejs/kit": "^2.49.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^25.0.3",
    "@unocss/preset-icons": "^66.5.10",
    "drizzle-kit": "^0.31.8",
    "svelte": "^5.46.0",
    "svelte-check": "^4.3.5",
    "typescript": "^5.9.3",
    "unocss": "^66.5.10",
    "vite": "^7.3.0",
    "zod": "^4.2.1"
  }
