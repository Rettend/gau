---
import Layout from '../layouts/Layout.astro';
import AuthIsland from '../components/AuthIsland.svelte';
const session = await Astro.locals.getSession();
const { user } = session;
if (!user) return Astro.redirect('/');
---
<Layout>
  <h1 class="text-2xl tracking-tight mb-6">Your account</h1>
  <AuthIsland session={session} controls client:load />
</Layout>
