{
  "name": "gau-monorepo",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.0",
  "scripts": {
    "build": "bun --bun --cwd packages/gau tsup",
    "dev": "bun --bun --cwd packages/gau tsup --watch",
    "lint": "bun --bun eslint . --fix",
    "lint:test": "eslint coverage.json --fix",
    "check": "cd packages/gau && bun run check",
    "check:test": "cd packages/gau && bun run check:test",
    "test": "vitest --project fast",
    "test:pg": "vitest --project pg",
    "test:all": "vitest && bun run lint:test",
    "test:ui": "vitest --project fast --ui",
    "update": "taze latest -wr",
    "release": "bumpp packages/gau/package.json packages/gau/jsr.json && bun run build && bun publish --cwd packages/gau"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.0.0",
    "@sveltejs/kit": "^2.47.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/bun": "^1.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20251021.1",
    "@unocss/eslint-plugin": "^66.5.4",
    "@unocss/reset": "^66.5.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "bumpp": "^10.3.1",
    "eslint": "^9.38.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-format": "^1.0.2",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-svelte": "^3.12.5",
    "prettier-plugin-astro": "^0.14.1",
    "svelte": "^5.41.1",
    "taze": "^19.8.1",
    "terser": "^5.44.0",
    "tsup": "^8.5.0",
    "unbuild": "^3.6.1",
    "unocss": "^66.5.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.43.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "trustedDependencies": [
    "@parcel/watcher",
    "better-sqlite3",
    "esbuild",
    "sharp",
    "workerd"
  ],
  "resolutions": {
    "vite": "^7.1.11"
  }
}
