{
  "name": "gau-monorepo",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "build": "bun --bun --cwd packages/gau tsup",
    "dev": "bun --bun --cwd packages/gau tsup --watch",
    "lint": "bun --bun eslint . --fix",
    "lint:test": "eslint coverage.json --fix",
    "check": "cd packages/gau && bun run check",
    "check:test": "cd packages/gau && bun run check:test",
    "test": "vitest --project fast",
    "test:pg": "vitest --project pg",
    "test:all": "vitest && bun run lint:test",
    "test:ui": "vitest --project fast --ui",
    "update": "taze latest -wr",
    "clean": "bun --bun scripts/clean.ts",
    "release": "bun node_modules/@rttnd/release/dist/cli.js"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@rttnd/release": "^0.1.1",
    "@solidjs/vite-plugin": "3.0.0-next.46",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@unocss/eslint-plugin": "^66.10.5",
    "@unocss/reset": "^66.10.5",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-solid": "^0.18.0",
    "eslint-plugin-svelte": "^3.23.0",
    "prettier-plugin-astro": "^1.1.0",
    "svelte": "^5.57.1",
    "taze": "^21.2.0",
    "terser": "^5.51.2",
    "tsup": "^8.5.1",
    "unbuild": "^3.6.1",
    "typescript": "^6.0.3",
    "unocss": "^66.10.5",
    "vite": "^8.3.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "trustedDependencies": [
    "@parcel/watcher",
    "better-sqlite3",
    "esbuild",
    "sharp",
    "workerd"
  ]
}
